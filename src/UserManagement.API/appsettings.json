{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "logs/api-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14 }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=usermanagement.db"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "UserManagement.API",
    "Audience": "UserManagement.UI",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "ClockSkewSeconds": 30
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "no-reply@example.com",
    "FromName": "User Management",
    "PickupDirectoryOnly": false,
    "PickupDirectory": "App_Data/mail"
  },
  "Security": {
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "PasswordResetTokenMinutes": 30,
    "ResetPasswordUrl": "https://localhost:7260/Account/ResetPassword"
  },
  "Seed": {
    "Enabled": true,
    "AdminUserName": "admin",
    "AdminEmail": "admin@example.com",
    "AdminPassword": ""
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:7260", "http://localhost:5198" ]
  }
}
