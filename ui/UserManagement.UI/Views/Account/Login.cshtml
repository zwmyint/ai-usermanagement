@model UserManagement.UI.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h2 class="mb-4">Sign in</h2>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div class="mb-3">
                <label asp-for="UserNameOrEmail" class="form-label"></label>
                <input asp-for="UserNameOrEmail" class="form-control" autofocus />
                <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Sign in</button>
        </form>
        <div class="mt-3 d-flex justify-content-between">
            <a asp-controller="Account" asp-action="Register">Create an account</a>
            <a asp-controller="Account" asp-action="ForgotPassword">Forgot password?</a>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
